# Copy to .env (never commit .env). Used by Tomcat (via context.xml) and by the test suite.
CIVIC_DB_URL=jdbc:postgresql://localhost:5432/civicconnect
CIVIC_DB_USER=civic_app
CIVIC_DB_PASSWORD=change-me

# Integration tests only - a SEPARATE throw-away database; its "civic" schema is dropped and rebuilt.
CIVIC_TEST_DB_URL=jdbc:postgresql://localhost:5432/civicconnect_test
CIVIC_TEST_DB_USER=civic_owner
CIVIC_TEST_DB_PASSWORD=change-me
